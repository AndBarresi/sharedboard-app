{
  "name": "sharedboard-app",
  "version": "0.10.4",
  "private": true,
  "author": {
    "name": "Andrew Barresi",
    "url": "https://github.com/AndBarresi"
  },
  "license": "MIT",
  "homepage": "https://sharedboard.app",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "build": "node scripts/build-web.mjs",
    "build:web": "node scripts/build-web.mjs",
    "preview:web": "node scripts/preview-web.mjs",
    "package:web": "node scripts/package-web.mjs",
    "change": "node scripts/release.mjs record",
    "start": "node scripts/preview-web.mjs",
    "test": "node --test test/*.test.mjs",
    "relay:dev": "wrangler dev --config cloudflare/wrangler.jsonc --port 8787 --var RELAY_ORIGIN:http://127.0.0.1:8787 --var APP_ORIGIN:http://127.0.0.1:4317",
    "relay:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/server": "2.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "^6.2.6",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  }
}
